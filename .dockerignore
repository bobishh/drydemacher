src-tauri/
runtimes/
*.wasm

# Git / CI / editor
.git/
.github/
.vscode/
.idea/
.claude/
.svelte-kit/
.DS_Store
*.log

# E2E / test artifacts
e2e/
playwright-report/
test-results/

# Skills / agent docs
skills/
AGENTS.md
GEMINI.md
