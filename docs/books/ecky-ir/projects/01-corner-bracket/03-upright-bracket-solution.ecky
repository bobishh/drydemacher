(model
  (params
    (number span 64 :label "bracket span" :min 40 :max 120 :step 2)
    (number foot_d 36 :label "foot depth" :min 20 :max 70 :step 2)
    (number stock_t 6 :label "stock thickness" :min 3 :max 12 :step 0.5))
  (part bracket
    (let* ((flange_h 40)
           (overlap stock_t)
           (gusset_w 32)
           (gusset_h 24))
      (build
        (shape foot (box span foot_d stock_t))
        (shape flange
          (translate 0 (- (/ foot_d 2) (/ overlap 2)) (/ flange_h 2)
            (box span overlap flange_h)))
        (shape gusset_profile
          (polygon ((-16 0) (16 0) (0 gusset_h))))
        (shape gusset
          (translate 0 (- (/ foot_d 2) (/ stock_t 2)) stock_t
            (rotate 90 0 0
              (extrude gusset_profile stock_t))))
        (result (union foot flange gusset))))))
