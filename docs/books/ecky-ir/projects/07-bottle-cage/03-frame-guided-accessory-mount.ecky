(model
  (params
    (number rail_span 48 :label "accessory rail span" :min 32 :max 80 :step 2)
    (number peg_radius 1.8 :label "locator peg radius" :min 1 :max 3 :step 0.2))
  ;; A cage-side accessory rail: a curved spine, end pad, locator grid, and clipped fan stops.
  (part frame_guided_accessory_mount
    (build
      (shape rail
        (bezier-path ((-24 0 4) (-10 6 8) (10 -6 10) (24 0 14))))
      (shape spine (sweep (circle 1.4) rail))
      (shape end_frame (path-frame rail :at end :up (0 0 1)))
      (shape pad (extrude (rounded-rect 14 10 2) 3))
      (shape end_pad (place end_frame pad :offset (0 0 -1.5)))
      (shape guide_polyline (polyline ((-20 -8 4) (-8 -8 6) (8 -8 6) (20 -8 4))))
      (shape guide (sweep (circle 0.8) guide_polyline))
      (shape compliant_tab
        (extrude (bspline ((-8 -4) (-4 -7) (4 -7) (8 -4) (8 4) (4 7) (-4 7) (-8 4)) :closed #t) 1.8))
      (shape base
        (difference
          (extrude (rounded-rect rail_span 26 3) 4)
          (arc-array 4 9 -55 55 (translate 0 0 -1 (cylinder 1.6 8)))))
      (shape locator_grid
        (grid-array 2 3 13 9 (translate -13 -4 4 (cylinder peg_radius 5))))
      (shape fan_stops
        (clip-box
          (radial-array 6 60 13 (translate 0 0 4 (cone 2 0.9 6)))
          :x (-24 24) :y (-13 13) :z (0 12)))
      (result (union base spine end_pad guide compliant_tab locator_grid fan_stops)))))
