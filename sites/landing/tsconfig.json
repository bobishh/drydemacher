{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["svelte"],
    "baseUrl": ".",
    "paths": {
      "@genome/*": [
        "../../src/lib/genie/*"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}
