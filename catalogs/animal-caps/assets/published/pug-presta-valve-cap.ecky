(model
  (params
    (number pug-scale 12 :label "Pug uniform scale" :min 10 :max 14 :step 0.1)
    (number sleeve-height 15mm :label "External sleeve height" :min 13mm :max 18mm :step 0.5mm :unit length)
    (number bore-center-z 0mm :label "Bore center offset" :min -3mm :max 3mm :step 0.1mm :unit length)
    (number base-thread-clearance 0.15mm :label "Base thread clearance" :min 0.08mm :max 0.3mm :step 0.01mm :unit length)
    (number fit-adjustment 0mm :label "Thread fit adjustment" :min -0.1mm :max 0.3mm :step 0.05mm :unit length)
    :relations ((> pug-scale 9.9) (> sleeve-height 12.9mm)))
  (verify (tag preview_exists) (metric preview (manifest has-preview-stl)) (expect preview (= true)))
  (verify (tag one_pug_cap) (metric parts (manifest part-count)) (expect parts (= 1)))
  (verify (tag connected_cap) (metric components (stl connected-component-count)) (expect components (= 1)))
  (verify (tag watertight_cap) (metric bad_edges (stl non-manifold-edge-count)) (expect bad_edges (= 0)))
  (part pug-presta-cap
    (let*
      ((presta-major-d 5.98mm)
       (presta-thread-depth 0.40mm)
       (thread-clearance (+ base-thread-clearance fit-adjustment))
       (presta-thread-root-r (- (/ presta-major-d 2) presta-thread-depth))
       (thread-bore-r (+ presta-thread-root-r thread-clearance))
       (free-bore-r (+ (/ presta-major-d 2) 0.25mm))
       (thread-start-z 12mm)
       (thread-length 6mm)
       (thread-end-z (+ thread-start-z thread-length))
       (thread-transition-height 1.2mm)
       (thread-transition-overlap 0.05mm)
       (thread-transition-cut-height (+ thread-transition-height thread-transition-overlap))
       (lower-transition-start-z (- thread-start-z thread-transition-height))
       (upper-transition-start-z (- thread-end-z thread-transition-overlap))
       (inner-cone-start-z 22.2mm)
       (inner-cone-end-z 27.8mm)
       (inner-cone-height (- inner-cone-end-z inner-cone-start-z))
       (cutter-overshoot 0.3mm)
       (lower-bore-height (+ lower-transition-start-z cutter-overshoot thread-transition-overlap))
       (upper-bore-start-z (- (+ thread-end-z thread-transition-height) thread-transition-overlap))
       (upper-bore-height (- inner-cone-start-z upper-bore-start-z))
       (entry-lead-height 1.0mm)
       (entry-mouth-r (+ free-bore-r 0.35mm))
       (entry-flare-r (+ entry-mouth-r 1.25mm))
       (entry-flare-height 1.0mm)
       (entry-flare-start-z -0.25mm)
       (sleeve-outer-r 6.2mm)
       (pug-floor-offset-y (* 0.018065mm pug-scale)))
      (build
        (shape pug-positive
          (translate 0 pug-floor-offset-y 0
            (scale pug-scale pug-scale pug-scale
              (solidify (import-stl "/Users/bogdan/Library/Application Support/com.alcoholics-audacious.ecky-cad/reference-meshes/quaternius-farm-animals-cc0/Pug.stl")))))
        (shape sleeve-z (cylinder sleeve-outer-r sleeve-height 128))
        (shape sleeve (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg sleeve-z)))
        (shape body-positive (union pug-positive sleeve))
        (shape entry-flare-z (translate 0 0 entry-flare-start-z (cone entry-flare-r entry-mouth-r entry-flare-height 128)))
        (shape entry-lead-z (translate 0 0 (- cutter-overshoot) (cone entry-mouth-r free-bore-r entry-lead-height 128)))
        (shape lower-free-bore-z (translate 0 0 (- cutter-overshoot) (cylinder free-bore-r lower-bore-height 128)))
        (shape lower-thread-transition-z (translate 0 0 lower-transition-start-z (cone free-bore-r thread-bore-r thread-transition-cut-height 128)))
        (shape thread-root-bore-z (translate 0 0 thread-start-z (cylinder thread-bore-r thread-length 128)))
        (shape upper-thread-transition-z (translate 0 0 upper-transition-start-z (cone thread-bore-r free-bore-r thread-transition-cut-height 128)))
        (shape upper-free-bore-z (translate 0 0 upper-bore-start-z (cylinder free-bore-r upper-bore-height 128)))
        (shape supportless-inner-roof-z (translate 0 0 inner-cone-start-z (cone free-bore-r 0mm inner-cone-height 128)))
        (shape entry-flare (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg entry-flare-z)))
        (shape entry-lead (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg entry-lead-z)))
        (shape lower-free-bore (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg lower-free-bore-z)))
        (shape lower-thread-transition (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg lower-thread-transition-z)))
        (shape thread-root-bore (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg thread-root-bore-z)))
        (shape upper-thread-transition (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg upper-thread-transition-z)))
        (shape upper-free-bore (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg upper-free-bore-z)))
        (shape supportless-inner-roof (translate 0 0 bore-center-z (rotate -90deg 0deg 0deg supportless-inner-roof-z)))
        (shape body-flared-open (difference body-positive entry-flare))
        (shape body-thread-root-open (difference body-flared-open thread-root-bore))
        (shape body-lower-open (difference body-thread-root-open lower-free-bore))
        (shape body-entry-open (difference body-lower-open entry-lead))
        (shape body-lower-transition-open (difference body-entry-open lower-thread-transition))
        (shape body-upper-transition-open (difference body-lower-transition-open upper-thread-transition))
        (shape body-upper-open (difference body-upper-transition-open upper-free-bore))
        (result (difference body-upper-open supportless-inner-roof)))))
)
